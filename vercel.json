{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/football-wso/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/public" }
    },
    {
      "src": "api/sessions/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/sessions/[id].ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/sessions/(.+)", "dest": "/api/sessions/[id].ts" },
    { "src": "/api/sessions", "dest": "/api/sessions/index.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/" }
  ]
}
