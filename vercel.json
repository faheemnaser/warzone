{
  "buildCommand": "pnpm --filter @workspace/football-wso run build",
  "outputDirectory": "artifacts/football-wso/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  }
}
